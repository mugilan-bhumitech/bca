# Bhumi Campus Awards (BCA) 2027 — React build
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Old shared links (.php / .html) -> new routes; UTM query strings are kept (QSA is implicit for R without ?)
  RewriteRule ^index\.(php|html)$ / [R=301,L]
  RewriteRule ^(summit|partner|vote)\.(php|html)$ /$1 [R=301,L]
  RewriteRule ^verification/?$ /vote [R=301,L]

  # Single-page app: everything that is not a real file goes to index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Hashed build assets can be cached forever; index.html must always be fresh
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
